# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_APPLICATION_CREDENTIALS_JSON: Service Account JSON key for Google Sheets API access.
# Required for grounding the AI consultant with products and knowledge.
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type": "service_account", ...}'

# GOOGLE_SHEETS_ID: The ID of the Google Sheet containing knowledge and products.
GOOGLE_SHEETS_ID=""
